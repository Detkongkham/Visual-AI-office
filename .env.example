# Copy this file to .env and fill in your own values.

# Your Claude API key (https://console.anthropic.com). Keep it secret - never commit .env.
ANTHROPIC_API_KEY=

# Port for the office web page: http://localhost:4317
PORT=4317

# The project folder the AI team works in. Use an absolute path to point them at a real project.
WORKSPACE_DIR=./workspace

# Safety limits
TASK_BUDGET_USD=1.00
DAILY_BUDGET_USD=10.00
