# Optional settings. The office works without this file:
# it signs in with your Claude Code login (the same one the Claude Code extension in Antigravity uses).

# Only needed if this Mac is not signed in to Claude Code. Your Claude Code login is used first when both exist.
# ANTHROPIC_API_KEY=

# Port for the office web page: http://localhost:4317
PORT=4317

# Default project folder (more folders can be added from the page)
WORKSPACE_DIR=./workspace

# Who plans and hands out work in team mode (a key from config/team.json)
TEAM_LEAD=somphone

# Safety cap per task (estimated cost). Plan limits (5-hour / weekly) come from your Claude account and are shown on the page.
TASK_BUDGET_USD=1.00
TEAM_BUDGET_USD=5.00
